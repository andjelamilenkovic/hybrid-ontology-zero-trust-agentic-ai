@prefix : <http://www.elfak.ni.ac.rs/zerotrust6g#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.elfak.ni.ac.rs/zerotrust6g#> .

<http://www.elfak.ni.ac.rs/zerotrust6g> rdf:type owl:Ontology ;
    rdfs:comment "Zero Trust access control for agentic systems in 6G. Trust threshold tau = 0.6, consistent with the formal model D(q), the proof of concept, and the LLM benchmark." .

#################################################################
#    Object Properties
#################################################################

###  http://www.elfak.ni.ac.rs/zerotrust6g#consistentWith
:consistentWith rdf:type owl:ObjectProperty ;
                rdfs:domain :Action ;
                rdfs:range :Goal .


###  http://www.elfak.ni.ac.rs/zerotrust6g#governedBy
:governedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Action ;
            rdfs:range :SecurityPolicy .


###  http://www.elfak.ni.ac.rs/zerotrust6g#hasRole
:hasRole rdf:type owl:ObjectProperty ;
         rdfs:domain :AutonomousAgent ;
         rdfs:range :WorkflowState .


###  http://www.elfak.ni.ac.rs/zerotrust6g#isAtState
:isAtState rdf:type owl:ObjectProperty ;
           rdfs:domain :AutonomousAgent ;
           rdfs:range :WorkflowState .


###  http://www.elfak.ni.ac.rs/zerotrust6g#operatesAt
:operatesAt rdf:type owl:ObjectProperty ;
            rdfs:domain :Entity ;
            rdfs:range :InfrastructureLayer .


###  http://www.elfak.ni.ac.rs/zerotrust6g#participatesIn
:participatesIn rdf:type owl:ObjectProperty ;
                rdfs:domain :Entity ;
                rdfs:range :Workflow .


###  http://www.elfak.ni.ac.rs/zerotrust6g#performsAction
:performsAction rdf:type owl:ObjectProperty ;
                rdfs:domain :Entity ;
                rdfs:range :Action .


###  http://www.elfak.ni.ac.rs/zerotrust6g#pursues
:pursues rdf:type owl:ObjectProperty ;
         rdfs:domain :AutonomousAgent ;
         rdfs:range :Goal .


###  http://www.elfak.ni.ac.rs/zerotrust6g#requestsAccessTo
:requestsAccessTo rdf:type owl:ObjectProperty ;
                  rdfs:domain :Entity ;
                  rdfs:range :Resource .


###  http://www.elfak.ni.ac.rs/zerotrust6g#transitionsTo
:transitionsTo rdf:type owl:ObjectProperty ;
               rdfs:domain :WorkflowState ;
               rdfs:range :WorkflowState .


###  http://www.elfak.ni.ac.rs/zerotrust6g#permittedAction
:permittedAction rdf:type owl:ObjectProperty ;
                  rdfs:domain :WorkflowState ;
                  rdfs:range :Action .


###  http://www.elfak.ni.ac.rs/zerotrust6g#requestsAction
:requestsAction rdf:type owl:ObjectProperty ;
                rdfs:domain :Request ;
                rdfs:range :Action .


###  http://www.elfak.ni.ac.rs/zerotrust6g#targetsResource
:targetsResource rdf:type owl:ObjectProperty ;
                  rdfs:domain :Request ;
                  rdfs:range :Resource .


###  http://www.elfak.ni.ac.rs/zerotrust6g#requestedBy
:requestedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Request ;
             rdfs:range :AutonomousAgent .


#################################################################
#    Data properties
#################################################################

###  http://www.elfak.ni.ac.rs/zerotrust6g#hasMinimumTrust
:hasMinimumTrust rdf:type owl:DatatypeProperty ;
                 rdfs:domain :SecurityPolicy ;
                 rdfs:range xsd:decimal .


###  http://www.elfak.ni.ac.rs/zerotrust6g#isAuthenticated
:isAuthenticated rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Entity ;
                 rdfs:range xsd:boolean .


###  http://www.elfak.ni.ac.rs/zerotrust6g#trustValue
:trustValue rdf:type owl:DatatypeProperty ;
            rdfs:domain :Entity ;
            rdfs:range xsd:decimal .


#################################################################
#    Classes
#################################################################

###  http://www.elfak.ni.ac.rs/zerotrust6g#Action
:Action rdf:type owl:Class ;
        rdfs:subClassOf owl:Thing .


###  http://www.elfak.ni.ac.rs/zerotrust6g#Agent
:Agent rdf:type owl:Class ;
       rdfs:subClassOf :Entity .


###  http://www.elfak.ni.ac.rs/zerotrust6g#AutonomousAgent
:AutonomousAgent rdf:type owl:Class ;
                 rdfs:subClassOf :Agent .


###  http://www.elfak.ni.ac.rs/zerotrust6g#CloudLayer
:CloudLayer rdf:type owl:Class ;
            rdfs:subClassOf :InfrastructureLayer .


###  http://www.elfak.ni.ac.rs/zerotrust6g#CompromisedAgent
###  An autonomous agent whose trust value is below the threshold tau = 0.6.
###  The bound is encoded as a datatype (facet) restriction so that the
###  reasoner, not the modeller, decides which individuals belong to the class.
:CompromisedAgent rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:intersectionOf ( :AutonomousAgent
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :trustValue ;
                                                               owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                    owl:onDatatype xsd:decimal ;
                                                                                    owl:withRestrictions ( [ xsd:maxExclusive 0.6 ] )
                                                                                  ]
                                                             ]
                                                           )
                                      ] ;
                  rdfs:subClassOf :AutonomousAgent .


###  http://www.elfak.ni.ac.rs/zerotrust6g#ContextualState
:ContextualState rdf:type owl:Class ;
                 rdfs:subClassOf owl:Thing .


###  http://www.elfak.ni.ac.rs/zerotrust6g#ControlLayer
:ControlLayer rdf:type owl:Class ;
              rdfs:subClassOf :InfrastructureLayer .


###  http://www.elfak.ni.ac.rs/zerotrust6g#Device
:Device rdf:type owl:Class ;
        rdfs:subClassOf :Entity .


###  http://www.elfak.ni.ac.rs/zerotrust6g#EdgeLayer
:EdgeLayer rdf:type owl:Class ;
           rdfs:subClassOf :InfrastructureLayer .


###  http://www.elfak.ni.ac.rs/zerotrust6g#Entity
:Entity rdf:type owl:Class ;
        rdfs:subClassOf owl:Thing .


###  http://www.elfak.ni.ac.rs/zerotrust6g#Goal
:Goal rdf:type owl:Class ;
      rdfs:subClassOf owl:Thing .


###  http://www.elfak.ni.ac.rs/zerotrust6g#InfrastructureLayer
:InfrastructureLayer rdf:type owl:Class ;
                     rdfs:subClassOf owl:Thing .


###  http://www.elfak.ni.ac.rs/zerotrust6g#Request
:Request rdf:type owl:Class ;
         rdfs:subClassOf owl:Thing .


###  http://www.elfak.ni.ac.rs/zerotrust6g#Resource
:Resource rdf:type owl:Class ;
          rdfs:subClassOf owl:Thing .


###  http://www.elfak.ni.ac.rs/zerotrust6g#SecurityPolicy
:SecurityPolicy rdf:type owl:Class ;
                rdfs:subClassOf owl:Thing .


###  http://www.elfak.ni.ac.rs/zerotrust6g#Service
:Service rdf:type owl:Class ;
         rdfs:subClassOf :Entity .


###  http://www.elfak.ni.ac.rs/zerotrust6g#TrustScore
:TrustScore rdf:type owl:Class ;
            rdfs:subClassOf owl:Thing .


###  http://www.elfak.ni.ac.rs/zerotrust6g#User
:User rdf:type owl:Class ;
      rdfs:subClassOf :Entity .


###  http://www.elfak.ni.ac.rs/zerotrust6g#Workflow
:Workflow rdf:type owl:Class ;
          rdfs:subClassOf owl:Thing .


###  http://www.elfak.ni.ac.rs/zerotrust6g#WorkflowState
:WorkflowState rdf:type owl:Class ;
               rdfs:subClassOf owl:Thing .


###  http://www.elfak.ni.ac.rs/zerotrust6g#PermittedRequest
:PermittedRequest rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:intersectionOf ( :Request
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :requestsAction ;
                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                   owl:oneOf ( :ReadAction )
                                                                 ]
                                           ]
                                         )
                                       ] .


###  http://www.elfak.ni.ac.rs/zerotrust6g#SemanticallyConsistentRequest
:SemanticallyConsistentRequest rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ;
                           owl:intersectionOf ( :Request
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :requestsAction ;
                               owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                     owl:onProperty :consistentWith ;
                                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                                          owl:oneOf ( :Goal_MonitorPatient ) ]
                                                   ]
                             ]
                           )
                         ] .


#################################################################
#    Individuals
#################################################################

###  Infrastructure layer instance
:EdgeLayer_001 rdf:type owl:NamedIndividual ,
                        :EdgeLayer .


###  Goals
:Goal_MonitorPatient rdf:type owl:NamedIndividual ,
                              :Goal .

:Goal_DataExfiltration rdf:type owl:NamedIndividual ,
                                :Goal .


###  Actions
:ReadAction rdf:type owl:NamedIndividual , :Action .
:WriteAction rdf:type owl:NamedIndividual , :Action .
:AnalyzeAction rdf:type owl:NamedIndividual , :Action .
:NotifyAction rdf:type owl:NamedIndividual , :Action .

###  Action-goal semantic consistency
:ReadAction :consistentWith :Goal_MonitorPatient .


###  Resource
:VitalSignsResource rdf:type owl:NamedIndividual , :Resource .


###  Workflow states (clinical-monitoring workflow)
:ReadVitalsState rdf:type owl:NamedIndividual , :WorkflowState ;
                 :permittedAction :ReadAction .

:AnalyzeDataState rdf:type owl:NamedIndividual , :WorkflowState ;
                  :permittedAction :ReadAction , :AnalyzeAction .

:SendAlertState rdf:type owl:NamedIndividual , :WorkflowState ;
                :permittedAction :WriteAction , :NotifyAction .


###  Agents
###  Legitimate monitoring agent: operates at the edge, trust 0.85 (above tau).
###  Added so that CQ1 (edge agents) returns a mixed set and CQ4 (below threshold)
###  must separate it from the compromised agent rather than returning the only
###  edge agent by default.
:MonitoringAgent_001 rdf:type owl:NamedIndividual ,
                              :AutonomousAgent ;
                     :operatesAt :EdgeLayer_001 ;
                     :trustValue 0.85 ;
                     :pursues :Goal_MonitorPatient .

###  Compromised agent: operates at the edge, trust 0.15 (below tau = 0.6).
:CompromisedAgent_002 rdf:type owl:NamedIndividual ,
                               :AutonomousAgent ;
                      :operatesAt :EdgeLayer_001 ;
                      :trustValue 0.15 .

###  Unauthenticated agent (authentication example)
:UnauthAgent_005 rdf:type owl:NamedIndividual ,
                          :AutonomousAgent ;
                 :isAuthenticated false .

###  CQ6 test case: a permitted action (ReadAction is permitted in ReadVitalsState)
###  issued by an agent whose declared goal is data exfiltration, i.e. not
###  consistentWith the action. Detecting this requires following requestedBy
###  and pursues back to the agent (see the paper, left to a SWRL rule).
:MaliciousAgent_010 rdf:type owl:NamedIndividual , :AutonomousAgent ;
                    :pursues :Goal_DataExfiltration ;
                    :isAtState :ReadVitalsState .


###  Requests
:Request_S1 rdf:type owl:NamedIndividual , :Request ;
            :requestsAction :ReadAction ;
            :targetsResource :VitalSignsResource ;
            :requestedBy :MonitoringAgent_001 .

:Request_S3 rdf:type owl:NamedIndividual , :Request ;
            :requestsAction :WriteAction ;
            :targetsResource :VitalSignsResource .

:Request_S4 rdf:type owl:NamedIndividual , :Request ;
            :requestsAction :ReadAction ;
            :targetsResource :VitalSignsResource .

:Request_S6 rdf:type owl:NamedIndividual , :Request ;
            :requestsAction :ReadAction ;
            :targetsResource :VitalSignsResource ;
            :requestedBy :MaliciousAgent_010 .
